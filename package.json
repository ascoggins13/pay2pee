{
  "name": "pay2pee",
  "version": "1.0.0",
  "scripts": {
    "start": "node index.js",
    "heroku-postbuild": "npm install --production --force && npm rebuild",
    "verify-deps": "node verify-deps.js",
    "dev": "nodemon index.js",
    "clean-install": "rm -rf node_modules package-lock.json && npm install",
    "postinstall": "if [ ! -d \"node_modules/express/lib/router\" ]; then npm install express@4.18.2 --force || (curl -L https://github.com/expressjs/express/archive/4.18.2.tar.gz | tar xz && mv express-4.18.2 node_modules/express && rm -rf express-4.18.2); fi"
  },
  "engines": {
    "node": "18.20.2",
    "npm": "9.x"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "body-parser": "1.20.2",
    "cors": "2.8.5",
    "debug": "4.3.4",
    "dotenv": "16.5.0",
    "express": "4.18.2",
    "express-validator": "7.2.1",
    "firebase-admin": "13.4.0",
    "iconv-lite": "0.6.3",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.16.0",
    "morgan": "1.10.0",
    "path-to-regexp": "6.2.1",
    "stripe": "18.2.1"
  },
  "devDependencies": {
    "nodemon": "3.1.0"
  }
}